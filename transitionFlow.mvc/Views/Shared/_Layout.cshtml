@inject TransitFlow.mvc.Services.IComponentAssetManager AssetManager
@inject TransitFlow.mvc.Services.ICurrentUserService CurrentUserService
@{
    var currentUser = CurrentUserService.GetUser();
    var userAuthenticated = currentUser != null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - transitionFlow.mvc</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TransitFlow.mvc.styles.css" />

    @foreach (var style in AssetManager.GetStyles())
    {
        <link rel="stylesheet" href="@style" />
    }

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <div class="header-container">
            <div class="header-meta"> 
                <h1 class="header-title">TransitSim</h1>
                <p class="header-subtitle">Система моделювання міського транспорту</p>
            </div>
            <div class="header-buttons">
                @RenderSection("HeaderFilter", required: false)

                @if (userAuthenticated)
                {
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
                        <button type="submit" class="icon-btn header-icon-btn" title="Logout">
                            <img src="~/images/icons/logout.svg" alt="IconBtn" />
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="icon-btn header-icon-btn" title="Login">
                        <img src="~/images/icons/login.svg" alt="IconBtn" />
                    </a>
                }
            </div>
        </div>
    </header>
        <main role="main">
            @RenderBody()
        </main>

    <footer>
        
    </footer>
    <div id="app-modal" class="modal-overlay">
        <div class="modal-window">
            <div class="modal-header">
                <h2 id="modal-title"></h2>
                <button class="js-close-modal" id="js-close-modal"><img src="~/images/icons/close.svg" alt="CloseIcon" /> </button>
            </div>
            <div id="modal-body-content"></div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/helpers/ModalManager.js" type="module" asp-append-version="true"></script>

    @foreach (var script in AssetManager.GetScripts())
    {
        if (script.IsModule)
        {
            <script src="@script.Src" type="module" asp-append-version="true"></script>
        }
        else
        {
            <script src="@script.Src" asp-append-version="true"></script>
        }
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
